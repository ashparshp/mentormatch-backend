# MentorMatch Backend Configuration Blueprint
# Copy this file to .env and fill in the required secrets.

# == Platform Server ==
PORT=8080
LOG_LEVEL=info

# == Infrastructure (REQUIRED) ==
# Example: postgres://user:password@localhost:5432/mentormatch
DATABASE_URL=

# == Identity & Access Control (REQUIRED) ==
# Generate a strong 32+ character random string for production
JWT_SECRET=

# == Payment Settlement (Razorpay) ==
# Required for session confirmation and payouts
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# == Notification Engine ==
# (Optional) Future integrations for Email/SMS
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
